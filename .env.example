# Local development — copy to .env
DATABASE_URL="mysql://root:@localhost:3306/qualilab_proto"
AUTH_SECRET="dev-secret-change-in-production-min-32-chars"
NODE_ENV=development

# Better Auth
# Leave BETTER_AUTH_URL unset in dev: any localhost port is trusted.
# BETTER_AUTH_URL="http://localhost:3000"
# BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3000"

# Demo-accounts panel on the login page (shown unless set to false)
# NEXT_PUBLIC_DEMO_MODE=false

# Email — leave unset in dev: sends are recorded, not delivered
# RESEND_API_KEY="re_..."
# A real mailbox of the laboratory, never a no-reply (RETOUR-LABO-28-10.md L4);
# Administration → Entreprise → « Envoi des e-mails » overrides it.
# EMAIL_FROM="Qualilab International <contact@qualilabinternational.com>"

# Production only (optional)
# PORT=3000
# HOSTNAME=0.0.0.0
