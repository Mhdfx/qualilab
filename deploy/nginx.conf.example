# Qualilab — 23/11/2026 perf: stream responses (loading skeletons paint early), upstream keepalive, timing log.
# Previous version: /root/nginx-qualilab.avant-perf-2026-11-23
log_format qualilab_timing "$time_iso8601 $status $request_method $uri rt=$request_time uct=$upstream_connect_time uht=$upstream_header_time urt=$upstream_response_time pf=$http_next_router_prefetch rsc=$http_rsc bytes=$body_bytes_sent";

map $http_upgrade $qualilab_connection_upgrade {
    default upgrade;
    ""      "";
}

upstream qualilab_app {
    server 127.0.0.1:3000;
    keepalive 32;
}

server {
    listen 80;
    server_name 185.217.126.53;
    client_max_body_size 10M;
    access_log /var/log/nginx/access.log;
    access_log /var/log/nginx/qualilab-timing.log qualilab_timing;

    location / {
        proxy_pass http://qualilab_app;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $qualilab_connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        proxy_buffering off;
        proxy_read_timeout 60s;
    }
}
