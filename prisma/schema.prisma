generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  PRELEVEUR
  RECEPTIONNISTE
  TECHNICIEN
  VALIDATEUR
  GESTIONNAIRE
  COMPTABLE
  ADMIN
  CLIENT
}

enum EmailType {
  RAPPORT
  ALERTE_CONTAMINATION
}

enum ResultWorkStatus {
  EN_COURS
  TERMINE
  ANOMALIE
}

enum ReportSendStatus {
  NON_ENVOYE
  ENVOYE
  ECHEC
}

enum SampleType {
  ALIMENTAIRE
  EAU
  AMBIANCE
}

enum SampleStatus {
  PRELEVE
  RECU
  EN_ANALYSE
  RESULTATS_SAISIS
  VALIDE
  RAPPORT_ENVOYE
}

enum InvoiceStatus {
  EN_ATTENTE
  PAYEE
}

/// Better Auth owns authentication (User/Session/Account/Verification).
/// `role` drives the LIMS authorization — keep in sync with src/lib/roles.ts.
model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  emailVerified   Boolean   @default(false)
  image           String?
  username        String?   @unique
  displayUsername String?
  role            String    @default("PRELEVEUR")
  banned          Boolean?  @default(false)
  banReason       String?
  banExpires      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sessions Session[]
  accounts Account[]

  samples          Sample[]
  invoices         Invoice[]
  receivedSamples  Sample[]  @relation("SampleReceivedBy")
  assignedSamples  Sample[]  @relation("SampleTechnician")
  validatedSamples Sample[]  @relation("SampleValidatedBy")
  enteredResults   Result[]
  auditLogs        AuditLog[]

  @@index([role])
}

model Session {
  id             String   @id @default(cuid())
  expiresAt      DateTime
  token          String   @unique
  ipAddress      String?
  userAgent      String?  @db.Text
  impersonatedBy String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Client {
  id       String    @id @default(cuid())
  name     String
  contact  String?
  /// Primary address, kept for the existing screens.
  email    String?
  phone    String?
  address  String?
  ice      String?
  emails   ClientEmail[]
  samples  Sample[]
  invoices Invoice[]
}

/// A client receives mail at several addresses: the client asked for reports
/// and contamination alerts to reach a list, not a single contact.
model ClientEmail {
  id       String  @id @default(cuid())
  clientId String
  client   Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  email    String
  label    String?
  /// Receives the analysis reports.
  forReports Boolean @default(true)
  /// Receives the contamination alerts.
  forAlerts  Boolean @default(true)

  @@unique([clientId, email])
  @@index([clientId])
}

model AnalysisParameter {
  id       String            @id @default(cuid())
  name     String
  category SampleType
  unit     String?
  /// Human-readable reference threshold shown to the technician.
  threshold String?
  /// Numeric limit used to decide conformity and to trigger alerts.
  limitValue Float?
  /// Sensitive microbiological parameters (E. coli, Salmonelle, Listeria):
  /// exceeding the limit triggers an automatic contamination alert to the
  /// client once the result is validated. Configurable by the admin.
  alertOnExceed Boolean @default(false)
  samples  SampleParameter[]
  results  Result[]
}

model LabService {
  id        String  @id @default(cuid())
  name      String
  category  String
  unitPrice Float   @default(0)
  active    Boolean @default(true)
}

model Sample {
  id       String @id @default(cuid())
  /// Internal field reference, created by the préleveur.
  code     String @unique
  /// Official numbering — assigned at RECEPTION only (client request 2026-07-28).
  /// Never visible to the préleveur.
  controlCode  String? @unique
  serialNumber String? @unique

  clientId String     @map("clientId")
  client   Client     @relation(fields: [clientId], references: [id])
  userId   String
  user     User       @relation(fields: [userId], references: [id])
  lieu     String
  /// Product sampled and its batch number — both appear in the alert email.
  produit    String?
  numeroLot  String?
  type     SampleType
  notes    String?    @db.Text
  status   SampleStatus @default(PRELEVE)

  // Workflow actors — each transition records who performed it.
  receivedById    String?
  receivedBy      User?     @relation("SampleReceivedBy", fields: [receivedById], references: [id])
  receivedAt      DateTime?
  conformity      Boolean?
  conformityNote  String?   @db.Text
  technicianId    String?
  technician      User?     @relation("SampleTechnician", fields: [technicianId], references: [id])
  assignedAt      DateTime?
  validatedById   String?
  validatedBy     User?     @relation("SampleValidatedBy", fields: [validatedById], references: [id])
  validatedAt     DateTime?
  rejectionReason String?   @db.Text

  sampledAt  DateTime          @default(now())
  createdAt  DateTime          @default(now())
  parameters SampleParameter[]
  results    Result[]
  report     Report?

  @@index([status])
  @@index([technicianId])
  @@index([clientId])
}

/// One measured value per (sample, parameter), entered by a technician.
model Result {
  id          String            @id @default(cuid())
  sampleId    String
  sample      Sample            @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  parameterId String
  parameter   AnalysisParameter @relation(fields: [parameterId], references: [id])

  /// The value exactly as the technician typed it (e.g. "8,9.10²").
  value      String?
  /// The same value parsed to a number. A contamination alert compares a result
  /// to its limit, and a display string cannot be compared — so both are kept.
  numericValue Float?
  unit       String?
  threshold  String?
  conform    Boolean?
  workStatus ResultWorkStatus @default(EN_COURS)
  note       String?          @db.Text

  enteredById String?
  enteredBy   User?    @relation(fields: [enteredById], references: [id])
  enteredAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([sampleId, parameterId])
  @@index([sampleId])
}

/// The official analysis report generated on validation.
model Report {
  id         String @id @default(cuid())
  sampleId   String @unique
  sample     Sample @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  number     String @unique
  conclusion String? @db.Text

  technicianName String?
  validatorName  String?
  validatedAt    DateTime?

  sendStatus ReportSendStatus @default(NON_ENVOYE)
  sentAt     DateTime?
  sentTo     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  emails    EmailLog[]
}

/// Delivery journal for report emails (date, recipient, status, resend).
model EmailLog {
  id         String   @id @default(cuid())
  reportId   String?
  report     Report?  @relation(fields: [reportId], references: [id], onDelete: SetNull)
  type       EmailType @default(RAPPORT)
  to         String
  subject    String
  status     String
  providerId String?
  error      String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([reportId])
}

/// Traceability: who did what, when. Written by logAudit() on every mutation.
model AuditLog {
  id       String  @id @default(cuid())
  actorId  String?
  actor    User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action   String
  entity   String
  entityId String?
  metadata String? @db.Text

  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId])
  @@index([createdAt])
}

model SampleParameter {
  sampleId    String
  parameterId String
  sample      Sample            @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  parameter   AnalysisParameter @relation(fields: [parameterId], references: [id])

  @@id([sampleId, parameterId])
}

model Invoice {
  id          String        @id @default(cuid())
  number      String        @unique
  clientId    String
  client      Client        @relation(fields: [clientId], references: [id])
  createdById String
  createdBy   User          @relation(fields: [createdById], references: [id])
  status      InvoiceStatus @default(EN_ATTENTE)
  issueDate   DateTime      @default(now())
  dueDate     DateTime?
  notes       String?       @db.Text
  taxRate     Float         @default(20)
  subtotal    Float         @default(0)
  taxAmount   Float         @default(0)
  total       Float         @default(0)
  items       InvoiceItem[]
  createdAt   DateTime      @default(now())
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Float   @default(1)
  unitPrice   Float   @default(0)
  lineTotal   Float   @default(0)
}
