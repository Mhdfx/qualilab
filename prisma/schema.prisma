generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  PRELEVEUR
  RECEPTIONNISTE
  TECHNICIEN
  VALIDATEUR
  GESTIONNAIRE
  COMPTABLE
  ADMIN
  CLIENT
  MAGASINIER
}

enum EmailType {
  RAPPORT
  ALERTE_CONTAMINATION
}

enum ResultWorkStatus {
  EN_COURS
  TERMINE
  ANOMALIE
}

enum ReportSendStatus {
  NON_ENVOYE
  ENVOYE
  ECHEC
}

enum SampleType {
  ALIMENTAIRE
  EAU
  AMBIANCE
}

enum SampleStatus {
  PRELEVE
  RECU
  EN_ANALYSE
  RESULTATS_SAISIS
  VALIDE
  RAPPORT_ENVOYE
}

enum InvoiceStatus {
  EN_ATTENTE
  PAYEE
}

/// Better Auth owns authentication (User/Session/Account/Verification).
/// `role` drives the LIMS authorization — keep in sync with src/lib/roles.ts.
model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  emailVerified   Boolean   @default(false)
  image           String?
  username        String?   @unique
  displayUsername String?
  role            String    @default("PRELEVEUR")
  banned          Boolean?  @default(false)
  banReason       String?
  banExpires      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sessions Session[]
  accounts Account[]

  samples          Sample[]
  invoices         Invoice[]
  receivedSamples  Sample[]  @relation("SampleReceivedBy")
  assignedSamples  Sample[]  @relation("SampleTechnician")
  validatedSamples Sample[]  @relation("SampleValidatedBy")
  approvedSamples  Sample[]  @relation("SampleApprovedBy")
  rejectedSamples  Sample[]  @relation("SampleRejectedBy")
  enteredResults   Result[]
  auditLogs        AuditLog[]
  purchaseInvoices PurchaseInvoice[] @relation("PurchaseInvoiceCreatedBy")
  stockMovements   StockMovement[]   @relation("StockMovementCreatedBy")

  @@index([role])
}

model Session {
  id             String   @id @default(cuid())
  expiresAt      DateTime
  token          String   @unique
  ipAddress      String?
  userAgent      String?  @db.Text
  impersonatedBy String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Client {
  id       String    @id @default(cuid())
  name     String
  contact  String?
  /// Primary address, kept for the existing screens.
  email    String?
  phone    String?
  address  String?
  ice      String?
  /// Clients are archived, never deleted: samples, reports and invoices refer
  /// to them and the laboratory's history must stay readable.
  archived Boolean   @default(false)
  createdAt DateTime @default(now())
  emails   ClientEmail[]
  samples  Sample[]
  invoices Invoice[]

  @@index([archived, name])
}

/// A client receives mail at several addresses: the client asked for reports
/// and contamination alerts to reach a list, not a single contact.
model ClientEmail {
  id       String  @id @default(cuid())
  clientId String
  client   Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  email    String
  label    String?
  /// Receives the analysis reports.
  forReports Boolean @default(true)
  /// Receives the contamination alerts.
  forAlerts  Boolean @default(true)

  @@unique([clientId, email])
  @@index([clientId])
}

model AnalysisParameter {
  id       String            @id @default(cuid())
  name     String
  category SampleType
  unit     String?
  /// Human-readable reference threshold shown to the technician.
  threshold String?
  /// Numeric limit used to decide conformity and to trigger alerts.
  limitValue Float?
  /// Sensitive microbiological parameters (E. coli, Salmonelle, Listeria):
  /// exceeding the limit triggers an automatic contamination alert to the
  /// client once the result is validated. Configurable by the admin.
  alertOnExceed Boolean @default(false)
  /// Multiplier applied to the technician's raw reading (dilution factor…) —
  /// the generic calculation mechanism awaiting the lab's official formulas
  /// (NEEDEDINFO item 6). 1 = the value entered is already final.
  calcFactor Float @default(1)
  samples  SampleParameter[]
  results  Result[]
}

model LabService {
  id        String  @id @default(cuid())
  name      String
  category  String
  /// Exact money — never Float. Read through `toMoney()`.
  unitPrice Decimal @default(0) @db.Decimal(12, 2)
  active    Boolean @default(true)
}

model Sample {
  id       String @id @default(cuid())
  /// Internal field reference, created by the préleveur.
  code     String @unique
  /// Official numbering — assigned at RECEPTION only (client request 2026-07-28).
  /// Never visible to the préleveur.
  controlCode  String? @unique
  serialNumber String? @unique

  clientId String     @map("clientId")
  client   Client     @relation(fields: [clientId], references: [id])
  userId   String
  user     User       @relation(fields: [userId], references: [id])
  lieu     String
  /// Product sampled and its batch number — both appear in the alert email.
  produit    String?
  numeroLot  String?
  type     SampleType
  notes    String?    @db.Text
  status   SampleStatus @default(PRELEVE)

  // Workflow actors — each transition records who performed it.
  receivedById    String?
  receivedBy      User?     @relation("SampleReceivedBy", fields: [receivedById], references: [id])
  receivedAt      DateTime?
  conformity      Boolean?
  conformityNote  String?   @db.Text
  /// Held at reception: non-conform while the lab's policy
  /// (LabSettings.blockNonConformAtReception) blocks such samples. It stays
  /// RECU and unassigned until an ADMIN releases it to a technician.
  analysisBlocked Boolean   @default(false)
  /// When the contamination alerts for this sample actually left — the guard
  /// that stops the approval from re-sending what the technical validation
  /// already dispatched (LabSettings.alertAfterTechnicalValidation).
  alertsSentAt    DateTime?
  technicianId    String?
  technician      User?     @relation("SampleTechnician", fields: [technicianId], references: [id])
  assignedAt      DateTime?
  /// Technical validation by the VALIDATEUR — the first of two approvals.
  validatedById   String?
  validatedBy     User?     @relation("SampleValidatedBy", fields: [validatedById], references: [id])
  validatedAt     DateTime?
  /// Final approval by the ADMIN — the second. The client requires BOTH on
  /// every sample (2026-08-18), so the status only becomes VALIDE once this is
  /// set. "Awaiting approval" is therefore a derived state — validated but not
  /// yet approved — rather than a seventh status, keeping the six tracked
  /// statuses the client's specification promises.
  approvedById    String?
  approvedBy      User?     @relation("SampleApprovedBy", fields: [approvedById], references: [id])
  approvedAt      DateTime?
  rejectionReason String?   @db.Text
  /// Who sent it back, so the technician knows which desk rejected it.
  rejectedById    String?
  rejectedBy      User?     @relation("SampleRejectedBy", fields: [rejectedById], references: [id])
  rejectedAt      DateTime?

  sampledAt  DateTime          @default(now())
  createdAt  DateTime          @default(now())
  parameters SampleParameter[]
  results    Result[]
  report     Report?
  invoiceItems InvoiceItem[]

  @@index([status])
  @@index([technicianId])
  @@index([clientId])
  // Composite indexes matching how the screens actually query, so the queues
  // stay fast once the table holds years of samples rather than a handful.
  @@index([status, receivedAt])
  @@index([technicianId, status])
  @@index([userId, createdAt])
  @@index([createdAt])
}

/// One measured value per (sample, parameter), entered by a technician.
model Result {
  id          String            @id @default(cuid())
  sampleId    String
  sample      Sample            @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  parameterId String
  parameter   AnalysisParameter @relation(fields: [parameterId], references: [id])

  /// The FINAL value, as printed on the report (e.g. "8,9.10²"). When the
  /// parameter has a calcFactor it is computed from the raw reading;
  /// otherwise it is exactly what the technician typed.
  value      String?
  /// The bench reading as typed, kept when a calcFactor transformed it —
  /// null means value IS the raw entry (factor 1, today's default).
  rawValue   String?
  /// The final value parsed to a number. A contamination alert compares a
  /// result to its limit, and a display string cannot be compared — so both
  /// are kept.
  numericValue Float?
  unit       String?
  threshold  String?
  conform    Boolean?
  workStatus ResultWorkStatus @default(EN_COURS)
  note       String?          @db.Text

  enteredById String?
  enteredBy   User?    @relation(fields: [enteredById], references: [id])
  enteredAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([sampleId, parameterId])
  @@index([sampleId])
  @@index([parameterId])
}

/// The official analysis report generated on validation.
model Report {
  id         String @id @default(cuid())
  sampleId   String @unique
  sample     Sample @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  number     String @unique
  conclusion String? @db.Text

  technicianName String?
  validatorName  String?
  validatedAt    DateTime?

  sendStatus ReportSendStatus @default(NON_ENVOYE)
  sentAt     DateTime?
  sentTo     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  emails    EmailLog[]
}

/// Delivery journal for report emails (date, recipient, status, resend).
model EmailLog {
  id         String   @id @default(cuid())
  reportId   String?
  report     Report?  @relation(fields: [reportId], references: [id], onDelete: SetNull)
  type       EmailType @default(RAPPORT)
  to         String
  subject    String
  status     String
  providerId String?
  error      String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([reportId])
  @@index([type, createdAt])
}

/// Traceability: who did what, when. Written by logAudit() on every mutation.
model AuditLog {
  id       String  @id @default(cuid())
  actorId  String?
  actor    User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action   String
  entity   String
  entityId String?
  metadata String? @db.Text

  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId])
  @@index([createdAt])
}

model SampleParameter {
  sampleId    String
  parameterId String
  sample      Sample            @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  parameter   AnalysisParameter @relation(fields: [parameterId], references: [id])

  @@id([sampleId, parameterId])
}

model Invoice {
  id          String        @id @default(cuid())
  number      String        @unique
  clientId    String
  client      Client        @relation(fields: [clientId], references: [id])
  createdById String
  createdBy   User          @relation(fields: [createdById], references: [id])
  status      InvoiceStatus @default(EN_ATTENTE)
  issueDate   DateTime      @default(now())
  dueDate     DateTime?
  notes       String?       @db.Text
  /// Exact money — never Float. Read through `toMoney()`.
  taxRate     Decimal       @default(20) @db.Decimal(5, 2)
  subtotal    Decimal       @default(0) @db.Decimal(12, 2)
  taxAmount   Decimal       @default(0) @db.Decimal(12, 2)
  total       Decimal       @default(0) @db.Decimal(12, 2)
  items       InvoiceItem[]
  createdAt   DateTime      @default(now())

  @@index([clientId])
  @@index([status])
  @@index([createdAt])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  /// The sample this line bills, when it came from an analysis rather than
  /// being typed by hand. It is what stops a sample being invoiced twice.
  sampleId    String?
  sample      Sample? @relation(fields: [sampleId], references: [id], onDelete: SetNull)
  description String
  quantity    Float   @default(1)
  unitPrice   Decimal @default(0) @db.Decimal(12, 2)
  lineTotal   Decimal @default(0) @db.Decimal(12, 2)

  @@index([invoiceId])
  @@index([sampleId])
}

/// The laboratory's own identity — printed on every report, invoice and email.
/// One row, edited by the admin, so changing the ICE or the RIB is data entry
/// rather than a deployment. `lib/company.ts` keeps the fallback defaults.
model CompanySettings {
  id      String @id @default("company")
  name    String
  tagline String @db.Text
  address String
  city    String
  phone   String
  email   String
  website String
  ice     String
  rc      String
  bank    String
  rib     String
  iban    String
  swift   String
  /// Logo as a data URI (PNG/JPEG/SVG ≤ 300 KB), printed on the PDF
  /// documents. The styled text brand is the fallback while it is absent —
  /// the HD file from the lab (NEEDEDINFO item 5) just gets uploaded here.
  logoData String? @db.LongText
  updatedAt DateTime @updatedAt
}

/// Workflow policy the ADMIN controls — a single row (id "lab"). Each field
/// encodes a client decision that is still pending (NEEDEDINFO §4): BOTH
/// behaviours are built, the toggle picks one, so the answer costs zero code.
model LabSettings {
  id String @id @default("lab")
  /// Decision n°10 — a sample declared non-conform at reception is analysed
  /// anyway (false, today's behaviour) or held unassigned until an ADMIN
  /// releases it to a technician (true).
  blockNonConformAtReception Boolean @default(false)
  /// Decision n°11 — contamination alerts leave right after the technical
  /// validation (true) instead of after the admin approval (false).
  alertAfterTechnicalValidation Boolean @default(false)
  updatedAt DateTime @updatedAt
}

// ————— Phase 6 · Achat & Stock (module MAGASINIER) —————

/// A supplier and its payment convention. Archived, never deleted — purchase
/// invoices refer to it and the payment history must stay readable.
model Supplier {
  id      String  @id @default(cuid())
  name    String  @unique
  contact String?
  email   String?
  phone   String?
  address String?
  ice     String?
  /// Payment convention: invoices are due N days after their issue date
  /// (0 = comptant). Used to compute each invoice's dueDate by default.
  paymentTermDays Int     @default(30)
  notes           String? @db.Text
  archived        Boolean @default(false)
  createdAt       DateTime @default(now())

  invoices PurchaseInvoice[]

  @@index([archived, name])
}

enum PurchaseInvoiceStatus {
  A_PAYER
  PAYEE
}

/// A supplier invoice to pay — the source of the payment-due alerts.
model PurchaseInvoice {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  /// The supplier's own invoice number, unique per supplier.
  number    String
  label     String?
  amount    Decimal  @db.Decimal(12, 2)
  issueDate DateTime
  /// Defaults to issueDate + the supplier's payment term; editable.
  dueDate   DateTime
  status    PurchaseInvoiceStatus @default(A_PAYER)
  paidAt    DateTime?
  createdById String?
  createdBy   User?   @relation("PurchaseInvoiceCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@unique([supplierId, number])
  @@index([status, dueDate])
}

/// A stock article. The quantity is the aggregate the movements maintain —
/// it is never edited directly, so the history always explains the level.
model StockItem {
  id       String @id @default(cuid())
  name     String @unique
  /// Free grouping the lab chooses (Milieux de culture, Réactifs, …).
  category String?
  /// Counting unit: boîte, flacon, L, kg, unité…
  unit     String
  quantity    Decimal @default(0) @db.Decimal(12, 2)
  /// Low-stock alert threshold; 0 disables the alert for this article.
  minQuantity Decimal @default(0) @db.Decimal(12, 2)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())

  movements StockMovement[]

  @@index([archived, name])
}

enum StockMovementType {
  ENTREE
  SORTIE
  AJUSTEMENT
}

/// One stock movement. Lot and expiry are optional until the lab says how
/// fine it tracks (NEEDEDINFO item 16) — recording them costs nothing and
/// removing is easier than adding.
model StockMovement {
  id     String            @id @default(cuid())
  itemId String
  item   StockItem         @relation(fields: [itemId], references: [id])
  type   StockMovementType
  /// Always positive; the type carries the direction. For AJUSTEMENT it is
  /// the absolute corrected quantity observed during the inventory.
  quantity   Decimal   @db.Decimal(12, 2)
  lot        String?
  expiryDate DateTime?
  note       String?   @db.Text
  createdById String?
  createdBy   User?   @relation("StockMovementCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([itemId, createdAt])
}
