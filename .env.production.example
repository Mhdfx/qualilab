# VPS production — copy to .env on the server
# Docker Compose (docker-compose.yml) reads DB_PASSWORD/DB_ROOT_PASSWORD and
# passes DATABASE_URL to the app itself.
DB_PASSWORD="STRONG_PASSWORD"
DB_ROOT_PASSWORD="ANOTHER_STRONG_PASSWORD"
# Generate AUTH_SECRET: openssl rand -base64 32

DATABASE_URL="mysql://qualilab_user:STRONG_PASSWORD@localhost:3306/qualilab_proto"
AUTH_SECRET="replace-with-openssl-rand-base64-32"
NODE_ENV=production
PORT=3000

# Better Auth — REQUIRED in production.
# Public origin of the app; must match what the browser uses.
BETTER_AUTH_URL="https://app.qualilab.ma"
# Comma-separated origins allowed to call the auth endpoints (CSRF).
BETTER_AUTH_TRUSTED_ORIGINS="https://app.qualilab.ma"

# Set to false only when testing over plain HTTP (use HTTPS in production)
# AUTH_COOKIE_SECURE=false

# Hide the demo-accounts panel on the login page once the lab has real accounts.
NEXT_PUBLIC_DEMO_MODE=false

# Email (Resend) — until these are set, sends are recorded in the journal with
# the status SIMULE instead of being delivered.
RESEND_API_KEY="re_..."
EMAIL_FROM="Qualilab International <no-reply@qualilabinternational.com>"

# Browser used to render report PDFs (VPS: apt install chromium)
# CHROMIUM_PATH=/usr/bin/chromium
