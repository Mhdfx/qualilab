# VPS production — copy to .env on the server (Docker Compose reads it).
# Only these variables are used by docker-compose.yml: the app receives
# DATABASE_URL from compose (built from DB_PASSWORD) and the image already
# carries NODE_ENV, PORT and CHROMIUM_PATH.
DB_PASSWORD="STRONG_PASSWORD"
DB_ROOT_PASSWORD="ANOTHER_STRONG_PASSWORD"
# Generate: openssl rand -base64 32
AUTH_SECRET="replace-with-openssl-rand-base64-32"

# Better Auth — REQUIRED. Public origin of the app, as the browser sees it.
BETTER_AUTH_URL="https://app.qualilab.ma"
# Comma-separated origins allowed to call the auth endpoints (CSRF).
BETTER_AUTH_TRUSTED_ORIGINS="https://app.qualilab.ma"
# ONLY while serving over plain HTTP (no domain yet): browsers drop Secure
# cookies on HTTP, so login would silently fail. Remove once HTTPS is on.
# AUTH_COOKIE_SECURE=false

# Demo-accounts panel on the login page: true during the demo phase, false
# at go-live — together with scripts/disable-demo-accounts.sh (DEPLOY.md).
# Inlined at BUILD time: rebuild after changing it.
NEXT_PUBLIC_DEMO_MODE=false

# Email (Resend) — until these are set, sends are journalised as SIMULE.
RESEND_API_KEY="re_..."
EMAIL_FROM="Qualilab International <no-reply@qualilabinternational.com>"
